{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "contentPartnerName": {
      "type": "string"
    },
    "contactName": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REJECTED"]
    },
    "applicationId": {
      "type": "string"
    }
  },
  "required": [
    "contentPartnerName",
    "websiteUrl",
    "description"
  ],
  "additionalProperties": false
}